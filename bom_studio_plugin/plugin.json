{
  "$schema": "https://go.kicad.org/api/schemas/v1",
  "identifier": "com.github.wayri.wayricad.bom-studio",
  "name": "WayriCAD BOM Studio",
  "description": "Review component fields, stage BOM edits, and export purchasing or assembly tables.",
  "runtime": {
    "type": "python",
    "min_version": "3.10.0"
  },
  "actions": [
    {
      "identifier": "open",
      "name": "WayriCAD BOM Studio",
      "description": "Review component fields, stage BOM edits, and export purchasing or assembly tables.",
      "show-button": true,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "desktop_entrypoint.py",
      "icons-light": [
        "resources/icon-24.png",
        "resources/icon-48.png",
        "resources/icon-96.png"
      ],
      "icons-dark": [
        "resources/icon-dark-24.png",
        "resources/icon-dark-48.png",
        "resources/icon-dark-96.png"
      ]
    }
  ]
}
