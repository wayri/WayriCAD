{
  "scope": "Reference wildcard",
  "ref": "U1",
  "pattern": "Radial outward",
  "add_vias": false,
  "unmatched": "skip",
  "groups": [
    {
      "name": "Power pins",
      "match": {"net": "VDD*,VCC*,GND", "ref": "U1", "pad": "*"},
      "settings": {"output_mode": "Via-in-pad", "via_diameter": 0.5, "via_drill": 0.25}
    },
    {
      "name": "Differential signals",
      "match": {"net": "TX_*,RX_*", "ref": "U1"},
      "settings": {"pattern": "Straight + angled escape", "escape_angle": 45, "pair_mode": "Auto differential pairs", "length": 2, "escape_layer": "F.Cu"}
    },
    {
      "name": "Control pins",
      "match": {"net": "CTRL*", "ref": "U1", "pad": "*"},
      "settings": {"pattern": "Custom-angle spread", "escape_angle": 30, "length": 1.5, "escape_layer": "B.Cu"}
    }
  ]
}
