{
  "$schema": "https://go.kicad.org/api/schemas/v1",
  "identifier": "com.github.wayri.wayricad.visual-diff",
  "name": "WayriCAD Visual Diff",
  "description": "Compare PCB and schematic Git revisions with native KiCad SVGs in a local interactive report.",
  "runtime": {
    "type": "python",
    "min_version": "3.10.0"
  },
  "actions": [
    {
      "identifier": "open",
      "name": "WayriCAD Visual Diff",
      "description": "Compare PCB and schematic Git revisions with native KiCad SVGs in a local interactive report.",
      "show-button": true,
      "scopes": [
        "pcb",
        "schematic",
        "project_manager"
      ],
      "entrypoint": "desktop_entrypoint.py",
      "icons-light": [
        "resources/icon-24.png",
        "resources/icon-48.png",
        "resources/icon-96.png"
      ],
      "icons-dark": [
        "resources/icon-dark-24.png",
        "resources/icon-dark-48.png",
        "resources/icon-dark-96.png"
      ]
    }
  ]
}
