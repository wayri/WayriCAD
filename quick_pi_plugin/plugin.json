{
  "$schema": "https://go.kicad.org/api/schemas/v1",
  "identifier": "com.github.wayri.wayricad.quick-pi",
  "name": "WayriCAD Quick PI",
  "description": "Local 2.5D power-integrity simulation with source/sink terminals, copper meshes and native result views.",
  "runtime": {
    "type": "python",
    "min_version": "3.10.0"
  },
  "actions": [
    {
      "identifier": "open",
      "name": "WayriCAD Quick PI",
      "description": "Local 2.5D power-integrity simulation with source/sink terminals, copper meshes and native result views.",
      "show-button": true,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "desktop_entrypoint.py",
      "icons-light": [
        "resources/icon-24.png",
        "resources/icon-48.png",
        "resources/icon-96.png"
      ],
      "icons-dark": [
        "resources/icon-dark-24.png",
        "resources/icon-dark-48.png",
        "resources/icon-dark-96.png"
      ]
    },
    {
      "identifier": "quick-therm",
      "name": "WayriCAD QuickTherm",
      "description": "Screen board and component temperatures with mapped thermal inputs and visual results.",
      "show-button": true,
      "scopes": ["pcb"],
      "entrypoint": "quick_therm_entrypoint.py",
      "icons-light": [
        "resources/quicktherm-24.png",
        "resources/quicktherm-48.png",
        "resources/quicktherm-96.png"
      ],
      "icons-dark": [
        "resources/quicktherm-dark-24.png",
        "resources/quicktherm-dark-48.png",
        "resources/quicktherm-dark-96.png"
      ]
    }
  ]
}
