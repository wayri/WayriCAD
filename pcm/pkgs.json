{
    "packages": [
        {
            "name": "KiWay Extract Pins",
            "description": "Modeless pin extraction, PCB cross-selection, visual diagrams, and interboard documentation for KiCad.",
            "description_full": "KiWay provides a focused, modeless Pin Extractor plus a separate Interboard & Harness workspace.\n\n**Features:**\n- Follow live PCB selection while the extractor remains open\n- Combine selected footprints with comma-separated wildcard reference, net, and value filters\n- Review native pin tables before deterministic CSV or Markdown export\n- Cross-select preview rows and highlight their PCB nets\n- Preview combined, signal-only, or power-only block diagrams inside the plugin and export the exact SVG\n- Build a networkx connectivity graph from pcbnew board data and optional KiCad XML netlists\n- Preserve hierarchical sheet paths and apply user-defined path/reference aliases\n- Import pin documents from other projects and auto-link board-level endpoints\n- Apply exact, normalized, wildcard, or regex link rules and flag ambiguous matches\n- Export cross-project trackers, harness SVGs, ICDs, test-point traces, and TM/TC tables\n- Check and install full-suite dependencies through an integrated guarded manager\n- Run deterministic inspect, extract, crosslink, validate, report, benchmark, and test commands outside KiCad\n\nOptional Python packages for full dashboard capability: networkx, matplotlib, markdown, and Pillow. The integrated dependency manager installs reviewed packages into KiCad's Python user-site.\n\nTargets KiCAD 9 and later.",
            "identifier": "kiway.extract.pins",
            "type": "plugin",
            "author": {
                "name": "Wayri (Yawar)",
                "contact": {
                    "github": "https://github.com/wayri"
                }
            },
            "license": "GPL-3.0",
            "resources": {
                "homepage": "https://github.com/wayri/KiWay",
                "icon": "https://raw.githubusercontent.com/wayri/KiWay/develop/extract_pins_plugin/icon.png"
