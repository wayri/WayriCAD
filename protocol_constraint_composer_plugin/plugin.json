{
  "$schema": "https://go.kicad.org/api/schemas/v1",
  "identifier": "com.github.wayri.wayricad.protocol-constraints",
  "name": "WayriCAD Protocol Constraint Composer",
  "description": "Detect protocol nets and compose reviewed KiCad custom design rules.",
  "runtime": {
    "type": "python",
    "min_version": "3.10.0"
  },
  "actions": [
    {
      "identifier": "open",
      "name": "WayriCAD Protocol Constraint Composer",
      "description": "Detect protocol nets and compose reviewed KiCad custom design rules.",
      "show-button": true,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "ipc_entrypoint.py",
      "icons-light": [
        "resources/icon-24.png",
        "resources/icon-48.png",
        "resources/icon-96.png"
      ],
      "icons-dark": [
        "resources/icon-dark-24.png",
        "resources/icon-dark-48.png",
        "resources/icon-dark-96.png"
      ]
    }
  ]
}
