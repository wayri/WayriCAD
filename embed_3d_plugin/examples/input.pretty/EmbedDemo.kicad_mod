(footprint "EmbedDemo"
  (version 20241229)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "WayriCAD Embed3D disposable transform/portability example")
  (attr smd)
  (property "Reference" "REF**" (at 0 -2.8 0) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15))))
  (property "Value" "EmbedDemo" (at 0 2.8 0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_rect (start -2 -2) (end 2 2)
    (stroke (width 0.15) (type default)) (fill none) (layer "F.SilkS"))
  (pad "1" smd rect (at -1 0) (size 1.2 1.8) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "2" smd rect (at 1 0) (size 1.2 1.8) (layers "F.Cu" "F.Paste" "F.Mask"))
  (model "../models/sample_box.wrl"
    (offset (xyz -0.25 0.5 0.8))
    (scale (xyz 1.25 0.8 1.5))
    (rotate (xyz 15 20 35)))
)
